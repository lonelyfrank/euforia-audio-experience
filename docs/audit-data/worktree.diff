+// TEMPORARY (audit worktree only): the probe fetches its plan and posts its results here.
+const AUDIT_DIR = process.env.AUDIT_DIR ?? '/tmp';
+const audit = (): Plugin => ({
+  name: 'audit',
+  configureServer(server) {
+    server.middlewares.use('/__audit/plan', (req, res) => {
+      const client = new URL(req.url ?? '', 'http://x').searchParams.get('client') ?? 'browser';
+      const file = `${AUDIT_DIR}/plan-${client}.json`;
+      res.setHeader('content-type', 'application/json');
+      res.end(fs.existsSync(file) ? fs.readFileSync(file) : '{}');
+    });
+    server.middlewares.use('/__audit/boot', (req, res) => {
+      const client = new URL(req.url ?? '', 'http://x').searchParams.get('client') ?? 'browser';
+      const file = `${AUDIT_DIR}/boot-${client}.json`;
+      res.setHeader('content-type', 'application/json');
+      res.end(fs.existsSync(file) ? fs.readFileSync(file) : '{}');
+    });
+    server.middlewares.use('/__audit/result', (req, res) => {
+      const client = new URL(req.url ?? '', 'http://x').searchParams.get('client') ?? 'browser';
+      let body = '';
+      req.on('data', (chunk) => { body += chunk; });
+      req.on('end', () => { fs.appendFileSync(`${AUDIT_DIR}/results-${client}.jsonl`, body + '\n'); res.end('ok'); });
+    });
+  },
+});
 
